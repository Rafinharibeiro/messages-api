PORT=3000

# Auth
AUTH_EMAIL=your-email
AUTH_PASSWORD=your-password
JWT_SECRET=change-me

# AWS / DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=messages

# Optional when not using an AWS profile or role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Datadog (opcional)
DATADOG_ENABLED=false
DATADOG_API_KEY=
DATADOG_SERVICE=messages-api
DATADOG_ENV=dev
DATADOG_HOSTNAME=
